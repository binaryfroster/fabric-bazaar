# ── FabricBazaar Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git — it is already in .gitignore.

# ── Flask ───────────────────────────────────────────────────────────────────
# development = local SQLite + debug. production = Postgres + secure cookies.
FLASK_ENV=development

# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production.
SECRET_KEY=change-this-to-a-long-random-string-minimum-32-chars

# ── Database ────────────────────────────────────────────────────────────────
# Development: leave DATABASE_URL blank to auto-use local SQLite.
#
# Production (Supabase — free, persistent Postgres): copy the "Connection string"
# from Supabase → Project Settings → Database. For serverless (Vercel) use the
# CONNECTION POOLER string (host contains "pooler.supabase.com", port 6543 or 5432).
# The legacy postgres:// scheme is auto-normalised to postgresql://.
# Example:
# DATABASE_URL=postgresql://postgres.abcdefgh:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
DATABASE_URL=

# First deploy convenience: set AUTO_INIT_DB=1 to create tables (and seed an
# empty DB) on cold start. Prefer seeding once locally, then leave this unset.
# AUTO_INIT_DB=1
# AUTO_SEED=1

# ── Razorpay (OPTIONAL) ─────────────────────────────────────────────────────
# Without these, online payment is hidden and Cash on Delivery still works.
# Get keys at https://dashboard.razorpay.com → Settings → API Keys.
# Use TEST keys (rzp_test_...) for development, LIVE keys for production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Your UPI handle for the direct-UPI button (optional; leave blank to hide it).
RAZORPAY_UPI_ID=

# ── Rate limiting (OPTIONAL) ────────────────────────────────────────────────
# Redis makes rate limiting durable across serverless invocations. Without it,
# limiting falls back to best-effort in-memory. Upstash offers a free Redis.
# REDIS_URL=rediss://default:password@host:6379

# ── Object storage for uploads (OPTIONAL) ───────────────────────────────────
# The bundled catalogue works without this. To let admins/sellers upload NEW
# images on a read-only serverless filesystem, configure an S3-compatible
# bucket. Supabase Storage is S3-compatible and free.
#   Supabase: Project Settings → Storage → S3 connection.
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ENDPOINT_URL=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_PREFIX=fabricbazaar
# Public base URL that serves the uploaded objects (e.g. the bucket's public URL).
MEDIA_PUBLIC_BASE_URL=
